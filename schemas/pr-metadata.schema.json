{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:development-process-harness:pr-metadata:v1",
  "title": "Pull request metadata contract",
  "description": "Normalized metadata extracted from a pull request body. The text parser is implemented by pr_metadata().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "umbrella_issue",
    "exact_source_sha",
    "spec_task_ids",
    "issue_links",
    "legacy_classification",
    "required_sections"
  ],
  "properties": {
    "feature_id": {"type": "string", "pattern": "^[0-9]{3,}$"},
    "umbrella_issue": {"type": "string", "pattern": "^#[0-9]+$"},
    "exact_source_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "spec_task_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^T[0-9]{3,}$"}
    },
    "issue_links": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^(Refs|Part of|Fixes|Closes|Resolves) #[0-9]+$"}
    },
    "legacy_classification": {
      "type": "string",
      "enum": ["remove", "retain-with-exception", "untouched"]
    },
    "required_sections": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "## Feature identity",
          "## Как проверено",
          "## Risk / validation lane",
          "## Issues",
          "## Legacy Impact",
          "## Перед merge"
        ]
      }
    }
  }
}
