{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:development-process-harness:feature-context:v1",
  "title": "Per-worktree feature context",
  "description": "Bounded metadata pointer for one feature checkout; never store secrets or private product data here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_directory", "feature_id", "branch", "source_sha", "owner", "risk_lane", "owned_paths"],
  "properties": {
    "schema_version": {"const": 1},
    "feature_directory": {"type": "string", "pattern": "^specs/[0-9]{3,}-[a-z0-9][a-z0-9-]*$"},
    "feature_id": {"type": "string", "pattern": "^[0-9]{3,}$"},
    "branch": {"type": "string", "minLength": 1, "maxLength": 244},
    "source_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "owner": {"type": "string", "minLength": 1, "maxLength": 128},
    "risk_lane": {"type": "string", "enum": ["tiny-low-risk", "active-spec-kit", "significant-feature", "high-risk-product", "release-deploy"]},
    "owned_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(?:/|$)).+"}},
    "task_ids": {"type": "array", "items": {"type": "string", "pattern": "^T[0-9]{3,}$"}}
  }
}
